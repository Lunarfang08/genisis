# Application
GENESIS_ENVIRONMENT=development
GENESIS_LOG_LEVEL=INFO
GENESIS_API_HOST=0.0.0.0
GENESIS_API_PORT=8000
GENESIS_API_PREFIX=/api/v1
GENESIS_CORS_ORIGINS=["http://localhost:3000"]
# Host-run services use localhost. Compose overrides these with service names.
GENESIS_DATABASE_URL=postgresql+asyncpg://genesis:genesis@localhost:5432/genesis
GENESIS_REDIS_URL=redis://localhost:6379/0
GENESIS_HEALTH_TIMEOUT_SECONDS=2.0
GENESIS_AUTH_SECRET_KEY=development-only-change-me-at-least-32-characters
GENESIS_ACCESS_TOKEN_MINUTES=15
GENESIS_REFRESH_TOKEN_DAYS=30
GENESIS_COOKIE_SECURE=false
GENESIS_AUTH_RATE_LIMIT=10
GENESIS_REQUEST_SIZE_LIMIT_BYTES=1048576
GENESIS_TRUSTED_HOSTS=["localhost","127.0.0.1"]

# Public API base URL used only as a server-side fallback. Browser authentication
# uses the same-origin /api/genesis proxy to keep cookies on one host.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side API base URL (Docker Compose overrides this to the `api` service).
GENESIS_INTERNAL_API_URL=http://127.0.0.1:8000/api/v1

# Optional AI annotations. The application works with these disabled.
GENESIS_AI_ENABLED=false
GENESIS_AI_PROVIDER=mock
GENESIS_AI_MODEL=llama-3.3-70b-versatile
GENESIS_AI_DAILY_CALL_BUDGET=5
GENESIS_AI_TIMEOUT_SECONDS=15
GENESIS_OLLAMA_BASE_URL=http://localhost:11434
# GENESIS_GROQ_API_KEY=
# GENESIS_OPENAI_API_KEY=
# GENESIS_ANTHROPIC_API_KEY=
